{
    "name": "peekabooauth/peekaboo-bundle",
    "description": "Peekaboo Bundle",
    "keywords": ["api", "peekabooauth", "peekaboo", "auth", "oauth", "symfony", "bundle"],
    "type": "symfony-bundle",
    "license": "GPL-3.0-only",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "psr/log": "^1|^2|^3",
        "symfony/framework-bundle": "^6.2",
        "symfony/http-client": "^6.2",
        "symfony/http-foundation": "^6.2",
        "symfony/http-kernel": "^6.2",
        "symfony/routing": "^6.2",
        "symfony/security-bundle": "^6.2",
        "symfony/security-core": "^6.2",
        "symfony/security-http": "^6.2",
        "symfony/validator": "^6.2",
        "symfony/yaml": "^6.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Peekabooauth\\PeekabooBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Peekabooauth\\PeekabooBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyze": "phpstan analyze"
    }
}
